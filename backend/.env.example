ENV=development
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://mlai:mlai@localhost:5432/mlai

# Upstox (broker API) — see architecture/claude/API_Sources.md §1/§3.
# Never commit real values. Token lifecycle is owned by app/providers/india/upstox.py.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# Gemini free tier — the click-triggered AI company summary and the NL
# research assistant. Get one at https://aistudio.google.com/apikey
# (a classic key, not one created via Cloud Console's Credentials page —
# see app/providers/ai/gemini_summary.py's module docstring, "Bug 1").
# Only _1 is required; _2/_3/_4 are optional fallback keys, ideally from
# separate Google accounts, tried in order if _1 fails (429/5xx/timeout).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Resend — verification and password-reset emails. https://resend.com/api-keys
# IMPORTANT: with the default onboarding@resend.dev sender, Resend will ONLY
# deliver to the address that owns the Resend account; every other recipient
# gets a 403. Verify a domain at resend.com/domains and point
# RESEND_FROM_EMAIL at an address on it before real users can sign up.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MarketLens AI <onboarding@resend.dev>

# Google OAuth for "Sign in with Google" — console.cloud.google.com, APIs &
# Services > Credentials > OAuth client ID > Web application. Register the
# redirect URI for EVERY environment you run. Local dev and the prod
# container share http://localhost:3000/api/auth/google/callback (the
# container frontend is on 3000 too); a hosted deploy adds its own domain,
# e.g. https://marketlensai.in/api/auth/google/callback, as a second URI.
# Google allows plain http only for localhost/127.0.0.1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Shared secret required in the X-Admin-Token header for /api/v1/admin/* endpoints.
ADMIN_TOKEN=

# Signs/verifies JWTs for user auth. Required — the app won't start
# without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Runs app.jobs.daily_ingestion once a day in-process (APScheduler). Only set
# this on a host that keeps one instance always running — on anything that
# scales to zero, leave it false and trigger `python -m app.jobs.daily_ingestion`
# from a platform cron job instead. See architecture/claude/Deployment.md §6.
ENABLE_SCHEDULER=false
DAILY_INGESTION_HOUR_IST=20

# Rate limiting (app/core/rate_limit.py) keys anonymous requests on IP.
# Whether to trust X-Forwarded-For for that — same shape as COOKIE_SECURE
# in the frontend: explicit, env-driven, safe by default. Leave false here
# and everywhere without a real reverse proxy in front (bare-metal dev,
# docker-compose.prod.yml's direct port exposure). Set true only on a host
# where an edge proxy genuinely sits in front (Render, Fly) — trusting the
# header with nothing in front to set it truthfully would let any caller
# hand-pick their own rate-limit key.
TRUST_FORWARDED_FOR=false
